{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Full GEO Pipeline",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "module": "src.run_pipeline",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--config",
                "questions.json"
            ]
        },
        {
            "name": "Run GEO Pipeline (Login)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "module": "src.run_pipeline",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--config",
                "questions.json",
                "--pause-for-login"
            ]
        },
        {
            "name": "Preprocess URLs",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "module": "src.preprocess_urls",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
